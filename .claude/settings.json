{
  "permissions": {
    "allow": [
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(sed -n *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(npm run lint)",
      "Bash(npm run lint --prefix *)",
      "Bash(npx eslint *)",
      "Bash(npm test)",
      "Bash(npm test --prefix *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/rebuild-shared.cjs"],
            "statusMessage": "Rebuilding packages/shared"
          }
        ]
      },
      {
        "type": "command",
        "command": "node",
        "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check-env.cjs"]
      }
    ]
  }
}
