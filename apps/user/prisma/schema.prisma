generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id     Int    @id @default(autoincrement())
  uuid   String @unique @default(uuid())
  email  String @unique
  name      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}