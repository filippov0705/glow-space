AUTH_URL=http://localhost:3001
MASTERS_URL=http://localhost:3003
USER_URL=http://localhost:3002
ENVIRONMENT=development

GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=

# Map tiles (inlined into the client bundle at build time).
# Leave empty to use the public OpenStreetMap tiles, which are fine for development only.
# Production needs a keyed provider such as MapTiler, Stadia or CARTO, e.g.
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=<key>
# When switching provider, set NEXT_PUBLIC_MAP_TILE_ATTRIBUTION together with NEXT_PUBLIC_MAP_TILE_URL:
# the provider's terms require its attribution.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
