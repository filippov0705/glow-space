generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model City {
  id      Int      @id @default(autoincrement())
  slug    String   @unique
  name    String
  country String
  lat     Float
  lng     Float
  masters Master[]

  @@map("cities")
}

model Category {
  id            Int              @id @default(autoincrement())
  slug          String           @unique
  name          String
  description   String?          @map("description")
  imageUrl      String?          @map("image_url")
  sortOrder     Int              @default(0) @map("sort_order")
  masters       MasterCategory[]
  subcategories Subcategory[]

  @@map("categories")
}

model Subcategory {
  id         Int    @id @default(autoincrement())
  categoryId Int    @map("category_id")
  slug       String
  name       String
  sortOrder  Int    @default(0) @map("sort_order")

  category  Category   @relation(fields: [categoryId], references: [id])
  offerings Offering[]

  // Slugs repeat across categories (e.g. "haircut" in hair and barbering).
  @@unique([categoryId, slug])
  // Target of the composite foreign key from offerings.
  @@unique([id, categoryId])
  @@map("subcategories")
}

model Master {
  id              Int     @id @default(autoincrement())
  uuid            String  @unique @default(uuid())
  userUuid        String  @unique @map("user_uuid")
  displayName     String  @map("display_name")
  photoUrl        String? @map("photo_url")
  status          Int
  cityId          Int     @map("city_id")
  address         String
  lat             Float
  lng             Float
  rating          Float?
  reviewsCount    Int     @default(0) @map("reviews_count")
  about           String? @db.Text
  experienceYears Int?    @map("experience_years")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  city       City             @relation(fields: [cityId], references: [id])
  categories MasterCategory[]
  languages  MasterLanguage[]
  works      Work[]
  offerings  Offering[]

  workingHours       WorkingHours[]
  scheduleExceptions ScheduleException[]
  bookings           Booking[]
  reviews            Review[]

  @@index([cityId, status, rating])
  @@map("masters")
}

model MasterCategory {
  masterId   Int @map("master_id")
  categoryId Int @map("category_id")

  master    Master     @relation(fields: [masterId], references: [id], onDelete: Cascade)
  category  Category   @relation(fields: [categoryId], references: [id])
  works     Work[]
  offerings Offering[]

  @@id([masterId, categoryId])
  @@map("master_categories")
}

model Language {
  id        Int    @id @default(autoincrement())
  code      String @unique
  name      String
  sortOrder Int    @default(0) @map("sort_order")

  masters MasterLanguage[]

  @@map("languages")
}

model MasterLanguage {
  masterId   Int @map("master_id")
  languageId Int @map("language_id")

  master   Master   @relation(fields: [masterId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@id([masterId, languageId])
  @@map("master_languages")
}

model Offering {
  id            String   @id @default(uuid())
  masterId      Int      @map("master_id")
  categoryId    Int      @map("category_id")
  subcategoryId Int      @map("subcategory_id")
  name          String
  price         Int // in cents
  currency      String   @default("EUR")
  durationMin   Int      @map("duration_min")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  master         Master         @relation(fields: [masterId], references: [id], onDelete: Cascade)
  // The subcategory must belong to one of the master's categories.
  masterCategory MasterCategory @relation(fields: [masterId, categoryId], references: [masterId, categoryId], onDelete: Cascade)
  subcategory    Subcategory    @relation(fields: [subcategoryId, categoryId], references: [id, categoryId])
  bookings       Booking[]

  @@index([masterId])
  @@index([subcategoryId])
  @@map("offerings")
}

model Work {
  id         Int      @id @default(autoincrement())
  masterId   Int      @map("master_id")
  categoryId Int      @map("category_id")
  imageUrl   String   @map("image_url")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  master         Master         @relation(fields: [masterId], references: [id], onDelete: Cascade)
  // The work's category must be one of the master's categories.
  masterCategory MasterCategory @relation(fields: [masterId, categoryId], references: [masterId, categoryId], onDelete: Cascade)

  @@index([masterId, sortOrder])
  @@map("works")
}

model SearchSuggestion {
  id        String  @id @default(uuid())
  text      String
  locale    String // "en", "ru", "lt"
  citySlug  String? @map("city_slug") // null = all cities
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  @@index([locale, isActive])
  @@map("search_suggestions")
}

// All schedule times are the master's local wall-clock time; there is no timezone column.

// Weekly working intervals. Several rows per weekday allow breaks.
model WorkingHours {
  id        Int    @id @default(autoincrement())
  masterId  Int    @map("master_id")
  weekday   Int // ISO: 1 = Monday ... 7 = Sunday
  startTime String @map("start_time") // HH:MM
  endTime   String @map("end_time") // HH:MM, after start_time (no crossing midnight)

  master Master @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@index([masterId, weekday])
  @@map("working_hours")
}

// Overrides the weekly schedule for one date: a day off or a single special interval.
model ScheduleException {
  id        Int      @id @default(autoincrement())
  masterId  Int      @map("master_id")
  date      DateTime @db.Date
  isDayOff  Boolean  @map("is_day_off")
  startTime String?  @map("start_time") // HH:MM, null when is_day_off
  endTime   String?  @map("end_time") // HH:MM, null when is_day_off

  master Master @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@unique([masterId, date])
  @@map("schedule_exceptions")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id             String        @id @default(uuid())
  masterId       Int           @map("master_id")
  offeringId     String        @map("offering_id")
  clientUserUuid String        @map("client_user_uuid")
  startsAt       DateTime      @map("starts_at") @db.Timestamp(3)
  endsAt         DateTime      @map("ends_at") @db.Timestamp(3)
  status         BookingStatus @default(CONFIRMED)
  // Snapshot of the offering at booking time.
  offeringName   String        @map("offering_name")
  price          Int // in cents
  currency       String
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  master   Master   @relation(fields: [masterId], references: [id], onDelete: Cascade)
  // Restrict keeps booking history when someone tries to delete an offering.
  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Restrict)

  // Overlapping PENDING/CONFIRMED bookings of one master are rejected by an
  // EXCLUDE constraint added by hand in the migration.
  @@index([clientUserUuid])
  @@map("bookings")
}

// One review per client per master. No link to bookings: they may be purged.
model Review {
  id             String    @id @default(uuid())
  masterId       Int       @map("master_id")
  clientUserUuid String    @map("client_user_uuid")
  // Snapshots copied at creation; author_name is updated when the user renames.
  authorName     String    @map("author_name")
  offeringName   String    @map("offering_name")
  rating         Int // 1..5
  // Null for star-only reviews; never an empty string.
  text           String?
  // Master's reply: both null or both set, and only when text is not null.
  replyText      String?   @map("reply_text")
  repliedAt      DateTime? @map("replied_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  master Master @relation(fields: [masterId], references: [id], onDelete: Cascade)

  // CHECKs and the partial index (master_id, created_at) WHERE text IS NOT NULL
  // are added by hand in the migration.
  @@unique([masterId, clientUserUuid])
  @@index([clientUserUuid])
  @@map("reviews")
}
